rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // El superadmin se reconoce por su correo EXACTO y VERIFICADO.
    // ⚠️ Nunca usar patrones tipo 'juanda.fonsecag@.*': cualquiera puede
    // registrarse con juanda.fonsecag@otrodominio.com (sin verificar el
    // correo) y el token pasaria el patron => superadmin regalado.
    // Para agregar otro superadmin: sumar aqui su correo real (de Google,
    // que llega con email_verified=true) y volver a publicar las reglas.
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'juanda.fonsecag@gmail.com';
    }

    // MIEMBRO REAL = sesion con CUENTA, no la sesion anonima del invitado.
    // El modo invitado se conserva con Anonymous Auth (shared.js:
    // iniciarSesionInvitado), asi que "request.auth != null" ya NO significa
    // "tiene cuenta": un anonimo tambien lo cumple. Para los datos de contacto
    // hay que exigir ademas que el proveedor no sea 'anonymous'.
    // El claim viene en el token de Firebase Auth como
    // request.auth.token.firebase.sign_in_provider (valores: 'anonymous',
    // 'password', 'google.com', 'custom'...).
    function esMiembroReal() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /artifacts/{appId} {

      // Sub-admin de colegio: tiene documento en admins/{uid}.
      function isSchoolAdmin() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid));
      }
      function isAdmin() { return isSuperAdmin() || isSchoolAdmin(); }

      // Colegio asignado al sub-admin (su alcance). Los sub-admins solo
      // llegan a los usuarios y novedades de SU colegio.
      function adminSchool() {
        return get(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid)).data.get('school', '');
      }

      // Regla dura multi-tenant: el tag de colegio NUNCA se autodeclara.
      // Un usuario solo puede escribirse un colegio si presenta un codigo de
      // invitacion ACTIVO de ese colegio (campo codigoInvitacion del perfil).
      function codigoValido(school, codigo) {
        return codigo is string && codigo != ''
          && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/codigos/$(codigo))
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/codigos/$(codigo)).data.get('colegioId', '') == school
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/codigos/$(codigo)).data.get('activo', false) == true;
      }
      // El TIPO tiene que salir del codigo, igual que el colegio. Nacer
      // 'egresado' no exige nada (es el valor por defecto y el de los 68
      // documentos anteriores al 2026-08-07); nacer 'profesor' exige un codigo
      // que diga 'profesor'. Sin esto, bastaba con mandar tipo:'profesor' en el
      // create y la credencial no valia nada.
      function tipoValidoAlCrear() {
        let tipo = request.resource.data.get('tipo', 'egresado');
        return tipo == 'egresado'
          || (tipo == 'profesor'
              && codigoValido(request.resource.data.get('school', ''), request.resource.data.get('codigoInvitacion', ''))
              && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/codigos/$(request.resource.data.get('codigoInvitacion', ''))).data.get('tipo', 'egresado') == 'profesor');
      }
      // Veto de reingreso. Sustituye al borrado de la cuenta de Firebase Auth,
      // que no se puede hacer desde el cliente (exige Admin SDK). Ver el match
      // de /bloqueados mas abajo: lo escribe el superadmin al eliminar.
      function estaBloqueado(uid) {
        return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/bloqueados/$(uid));
      }
      // En CREACION propia: o se nace SIN colegio (red general, sin modulos
      // pagados) o con el colegio que respalde un codigo valido. Ya no se
      // acepta 'LCP' a pelo: hasta el 2026-08-02 esa concesion dejaba que
      // cualquiera se autodeclarara del colegio desde la consola y heredara
      // TOEFL/DELF, que es justo lo que se le cobra a los colegios.
      function schoolValidaAlCrear() {
        let s = request.resource.data.get('school', '');
        return s == ''
          || codigoValido(s, request.resource.data.get('codigoInvitacion', ''));
      }
      // Campos de CONTROL del perfil: los pone la administracion, nunca el
      // dueno. Sin esto, un usuario suspendido se reactivaba solo con
      // update({accountStatus:'activo'}) y cualquiera se ponia la ruta
      // destacada de la portada. Los defaults son los mismos que usa el
      // codigo (shared.js: accountStatus||'activo', Boolean(rutaDestacada)),
      // para que un perfil viejo sin el campo no quede bloqueado. Con
      // set({merge:true}) request.resource.data trae el doc RESULTANTE, asi
      // que un guardado normal de perfil conserva el valor y pasa igual.
      function camposDeControlIntactos() {
        return request.resource.data.get('accountStatus', 'activo') == resource.data.get('accountStatus', 'activo')
          && request.resource.data.get('rutaDestacada', false) == resource.data.get('rutaDestacada', false)
          // El TIPO DE MIEMBRO es una credencial, no un dato del perfil: un
          // profesor es alguien a quien los estudiantes van a creer. Nadie se
          // lo cambia a si mismo desde el navegador; sale del codigo de
          // invitacion al crear la cuenta, y despues solo lo mueve la
          // administracion. Sin esta linea, "hazte profesor" era un update.
          && request.resource.data.get('tipo', 'egresado') == resource.data.get('tipo', 'egresado');
      }
      // En ACTUALIZACION propia: school sin cambio, completar el default LCP
      // cuando faltaba, o cambiarse con codigo valido del colegio destino.
      // Al ACTUALIZAR: se conserva el colegio que ya se tenia, o se reclama uno
      // con codigo valido. La linea (vieja=='' && nueva=='LCP') se quito el
      // 2026-08-02 por lo mismo que en la creacion: era autodeclararse el tag.
      function schoolValidaAlActualizar() {
        let nueva = request.resource.data.get('school', '');
        let vieja = resource.data.get('school', '');
        return nueva == vieja
          || codigoValido(nueva, request.resource.data.get('codigoInvitacion', ''));
      }

      // Directorio de egresados: CERRADO desde 2026-07-29 (paso 3 ejecutado).
      //
      // `read` incluye `list`, asi que con `if true` cualquiera volcaba los 68
      // perfiles por REST sin sesion. Ahora exige sesion, y el modo invitado
      // sobrevive porque el visitante sin cuenta recibe una sesion ANONIMA
      // (shared.js: iniciarSesionInvitado). Las dos condiciones que bloqueaban
      // este cambio quedaron verificadas ese dia:
      //   (a) proveedor "Anonimo" HABILITADO en la consola (se pidio un token
      //       anonimo por REST y lo emitio), y
      //   (b) migracion de contacto corrida: 24 perfiles movidos, telefono y
      //       correo de contacto ya viven en la subcoleccion privada de abajo,
      //       que exige cuenta REAL (esMiembroReal, el anonimo no pasa).
      // ⚠️ Si algun dia se apaga el proveedor Anonimo, esta linea tumba el
      // directorio publico entero: las dos cosas van juntas.
      match /public/data/alumni/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (
          isSuperAdmin()
          || (isSchoolAdmin() && request.resource.data.get('school', '') == adminSchool())
          // Un usuario eliminado por la administracion no puede recrearse el
          // perfil volviendo a entrar. Su cuenta de Firebase Auth sigue viva
          // (borrarla exige Admin SDK, imposible desde el cliente), asi que el
          // veto se aplica AQUI: sin esto, "eliminar usuario" solo borraba el
          // documento y la persona lo regeneraba en el siguiente login.
          || (request.auth.uid == userId && schoolValidaAlCrear() && tipoValidoAlCrear() && !estaBloqueado(userId))
        );
        allow update: if request.auth != null && (
          isSuperAdmin()
          || (isSchoolAdmin()
              && resource.data.get('school', '') == adminSchool()
              && request.resource.data.get('school', '') == adminSchool())
          || (request.auth.uid == userId && schoolValidaAlActualizar() && camposDeControlIntactos())
        );
        allow delete: if isSuperAdmin()
          || (isSchoolAdmin() && resource.data.get('school', '') == adminSchool());

        // Contacto PRIVADO del egresado: telefono y correo de contacto.
        // Estaban en el documento publico alumni/{uid}, y como `read` incluye
        // `list`, cualquiera podia volcar por REST el nombre, el correo y el
        // telefono de toda la red sin login. Ahora viven aqui:
        //   - lee el DUENO y el SUPERADMIN siempre;
        //   - lee cualquier MIEMBRO CON CUENTA REAL (para el boton de
        //     WhatsApp del directorio), pero NO el invitado anonimo;
        //   - escribe solo el dueno o el superadmin (el superadmin, para la
        //     herramienta de migracion que mueve el dato de los perfiles
        //     antiguos).
        // El id fijo es 'contacto' (shared.js: contactoPrivadoDoc), pero la
        // regla se deja por documento para no atarse a ese nombre.
        match /privado/{docId} {
          allow read: if request.auth != null && (
            request.auth.uid == userId
            || isSuperAdmin()
            || esMiembroReal()
          );
          allow create, update: if request.auth != null
            && (request.auth.uid == userId || isSuperAdmin());
          allow delete: if request.auth != null
            && (request.auth.uid == userId || isSuperAdmin());
        }

        // Hitos de la trayectoria: visibles tambien en modo invitado
        // (el slide panel del directorio carga la ruta del egresado).
        // Los sub-admins solo tocan rutas de egresados de su colegio.
        match /hitos/{hitoId} {
          allow read: if true;
          allow write: if request.auth != null && (
            request.auth.uid == userId
            || isSuperAdmin()
            || (isSchoolAdmin()
                && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/alumni/$(userId)).data.get('school', '') == adminSchool())
          );
        }

        // Resultados de práctica de idiomas (TOEFL/DELF). A diferencia de los
        // hitos, NO son públicos: son datos personales del estudiante. Los lee
        // el propio dueño y los admins de su colegio. Cada intento lo crea SOLO
        // el dueño (la práctica corre en su sesión) y es inmutable; borrarlo
        // puede el dueño o un admin de su colegio.
        match /examResults/{resultId} {
          function ownerSchool() {
            return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/alumni/$(userId)).data.get('school', '');
          }
          allow read: if request.auth != null && (
            request.auth.uid == userId
            || isSuperAdmin()
            || (isSchoolAdmin() && ownerSchool() == adminSchool())
          );
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if false;
          allow delete: if request.auth != null && (
            request.auth.uid == userId
            || isSuperAdmin()
            || (isSchoolAdmin() && ownerSchool() == adminSchool())
          );
        }

        // La sesion de entrenamiento que el alumno dejo a medias: donde iba, en
        // que orden le salieron las preguntas y que respondio. A diferencia de
        // itemAttempts, esto SI se sobrescribe (avanza con cada respuesta) y se
        // borra al terminar. Es un borrador de trabajo, no un hecho registrado,
        // asi que ni el colegio ni el superadmin tienen por que leerlo: el dato
        // que a ellos les sirve ya esta en itemAttempts.
        match /icfesSesion/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Intentos item por item del ICFES. Mismo criterio que examResults (son
        // progreso personal), y por la misma razon: el reporte por competencia
        // que ve el colegio se arma con esto. Inmutables: un intento es un hecho
        // ocurrido, corregirlo a posteriori falsearia el diagnostico.
        match /itemAttempts/{attemptId} {
          function ownerSchool() {
            return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/alumni/$(userId)).data.get('school', '');
          }
          allow read: if request.auth != null && (
            request.auth.uid == userId
            || isSuperAdmin()
            || (isSchoolAdmin() && ownerSchool() == adminSchool())
          );
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if false;
          allow delete: if request.auth != null && (
            request.auth.uid == userId
            || isSuperAdmin()
            || (isSchoolAdmin() && ownerSchool() == adminSchool())
          );
        }
      }

      // Colegios (multi-tenant): nombre, modulos pagados (toefl/delf), etc.
      // Lectura publica: el registro muestra el nombre del colegio del codigo
      // y la pagina de preparacion consulta los modulos sin exigir sesion.
      match /public/data/colegios/{colegioId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }

      // Banco de tests de práctica (TOEFL/DELF). Lectura publica: practicar no
      // exige sesion (igual que hoy con los arrays JS). Escritura solo
      // superadmin (gestiona el contenido). Multi-tenant futuro: campo school
      // para tests por colegio; por ahora todos globales (school:'').
      match /public/data/examTests/{testId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }

      // Banco de audio de los listening (DELF CO / TOEFL Listening). El audio
      // se genera UNA vez desde el admin y vive en Storage; aqui queda su ficha
      // (transcript, voces, url, duracion) para reusarlo en los tests. Lectura
      // publica como examTests: practicar no exige sesion.
      match /public/data/audioClips/{clipId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }

      // Estado publicado de los modulos que dependen de contenido montado a
      // mano (hoy: si el DELF CO ya tiene sus 3 audios). Lo escribe el estudio
      // de audio del admin y lo lee la tarjeta de Preparacion para no abrir un
      // examen mudo. Lectura publica porque esa tarjeta se ve sin sesion; es un
      // recuento, no trae contenido. Escritura solo superadmin.
      match /public/data/config/{docId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }

      // Banco de ITEMS del ICFES y los textos que alimentan varias preguntas.
      // Lectura publica como examTests (entrenar no exige sesion); escritura
      // solo superadmin. OJO: que un item no revisado no se le sirva a un
      // estudiante es regla de PRODUCTO, no de seguridad — el motor filtra
      // revisado==true. Aqui no se puede exigir, porque leer el banco completo
      // es justo lo que hace el motor para armar la sesion.
      match /public/data/examItems/{itemId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
      match /public/data/examStimuli/{stimulusId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }

      // Codigos de invitacion: GET publico (validar un codigo exige conocerlo,
      // el id ES el codigo), pero LIST solo superadmin para que nadie pueda
      // enumerar los codigos vigentes.
      match /public/data/codigos/{codigo} {
        allow get: if true;
        allow list: if isSuperAdmin();
        allow write: if isSuperAdmin();
      }

      // Organizaciones normalizadas (autocompletar del onboarding/perfil).
      // Solo se usan estando autenticado; cualquier autenticado aporta,
      // solo admin depura/borra.
      // Aceptaba create/update de cualquier autenticado SIN validar forma:
      // se podia inflar la coleccion con documentos arbitrarios (el
      // autocompletar los lee entero en cada onboarding). Ahora se exige la
      // forma real que escribe upsertOrganization() en shared.js:
      // { nombre, tipo, updatedAt } con merge. Se toleran ademas createdAt
      // y slug por si algun documento historico los trae (con merge, el doc
      // resultante conserva las claves viejas y sin esa tolerancia un
      // upsert sobre ellos quedaria bloqueado). 'tipo' no se enumera a
      // proposito: hoy son los HITO_TYPES + 'otro' y agregar un tipo nuevo
      // no deberia exigir republicar reglas.
      match /public/data/organizaciones/{orgId} {
        function organizacionValida() {
          let d = request.resource.data;
          return d.keys().hasOnly(['nombre','tipo','updatedAt','createdAt','slug'])
            && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 160
            && d.tipo is string && d.tipo.size() <= 40;
        }
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && organizacionValida();
        allow delete: if isAdmin();
      }

      // Agregados de la red (cuantos egresados, promociones, areas, rutas
      // completas). Lectura publica porque la portada los pinta antes de que
      // nadie inicie sesion; ESCRITURA solo de la administracion, que es la
      // unica que lee la coleccion entera y la unica en la que se puede
      // confiar para el numero. Si cualquiera pudiera escribir aqui, la
      // portada mostraria las cifras que le dictara un navegador ajeno.
      match /public/data/resumen/{docId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }

      // Noticias: lectura publica; el superadmin publica a cualquier
      // audiencia y el sub-admin SOLO a su colegio (campo audiencia).
      match /public/data/news/{newsId} {
        allow read: if true;
        allow create, update: if isSuperAdmin()
          || (isSchoolAdmin() && request.resource.data.get('audiencia', '') == adminSchool());
        allow delete: if isSuperAdmin()
          || (isSchoolAdmin() && resource.data.get('audiencia', '') == adminSchool());
      }

      // Contacto de terceros (empresas, aliados, contacto general) desde la
      // landing. CREATE es PUBLICO (quien escribe no tiene cuenta), pero con
      // FORMA ESTRICTA como barrera anti-spam basica: campos permitidos,
      // tipos, longitudes y estado inicial fijo. Leerlos/gestionarlos es SOLO
      // del superadmin: son leads comerciales de la red (empresas, aliados),
      // no tienen colegio y nada tienen que ver con el alcance de un
      // sub-admin. Antes decia isAdmin() => cualquier sub-admin los leia.
      // Si aparece spam real, el siguiente paso es un captcha (Turnstile).
      match /public/data/contactos/{contactoId} {
        function contactoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly(['tipo','nombre','organizacion','email','telefono','mensaje','estado','createdAt','userAgent'])
            && d.tipo in ['empresa','aliado','general']
            && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 120
            && d.email is string && d.email.size() >= 5 && d.email.size() <= 160 && d.email.matches('.+@.+[.].+')
            && d.mensaje is string && d.mensaje.size() >= 10 && d.mensaje.size() <= 3000
            && d.organizacion is string && d.organizacion.size() <= 160
            && d.telefono is string && d.telefono.size() <= 40
            && d.userAgent is string && d.userAgent.size() <= 300
            && d.estado == 'nuevo'
            && d.createdAt == request.time;
        }
        allow create: if contactoValido();
        allow read, update, delete: if isSuperAdmin();
      }

      // Usuarios de login (username -> authEmail/uid). Lectura publica
      // porque se resuelve ANTES de autenticar. Un usuario reserva su
      // propio username; el superadmin reserva el de un sub-admin nuevo
      // (lo crea con una app de auth secundaria, escribiendo un uid ajeno).
      // Antes decia isAdmin(): un sub-admin podia apuntar el username de
      // cualquiera a su propio uid (secuestro de login) o borrarlo.
      // El fix anterior (create y update juntos, mirando SOLO el uid
      // ENTRANTE) seguia siendo secuestrable: cualquier autenticado podia
      // sobrescribir el username de otro apuntandolo a su propio uid, y la
      // regla lo aprobaba porque el uid entrante era el suyo. Por eso ahora
      // create y update van separados: en UPDATE se exige que el DUENO
      // ACTUAL (resource.data.uid) sea quien escribe, ademas de que el uid
      // resultante siga siendo el suyo (no puede regalarselo a un tercero).
      // reserveUsername() escribe siempre uid = uid propio con merge, asi
      // que renovar/cambiar el propio username sigue funcionando; el
      // superadmin conserva la via libre para reservar el username de un
      // sub-admin nuevo (uid ajeno, creado con la app de auth secundaria).
      match /usernames/{username} {
        allow read: if true;
        allow create: if request.auth != null
          && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
        allow update: if isSuperAdmin() || (request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid);
        allow delete: if isSuperAdmin();
      }

      // Cuentas BLOQUEADAS: lista de control de la administracion (una entrada
      // por uid vetado). Vive fuera del perfil a proposito: si fuera un campo
      // del documento del egresado, un `update` propio podria intentar
      // pisarlo, y ademas quedaria expuesto en el listado publico del
      // directorio (bloqueado a la vista de todos).
      // Escritura: SOLO el superadmin (bloquear/desbloquear no es una accion
      // de colegio). Lectura: cada quien la SUYA (para que el cliente sepa que
      // esta vetado y no siga golpeando reglas que lo van a rechazar) y el
      // superadmin la lista completa. Nadie mas puede enumerar quien esta
      // bloqueado.
      // ⚠️ Esto es la frontera de DATOS, no el gate de la app: el bloqueo
      // efectivo se aplica en las reglas de cada coleccion o en el proxy.
      match /bloqueados/{userId} {
        allow get: if request.auth != null
          && (request.auth.uid == userId || isSuperAdmin());
        allow list: if isSuperAdmin();
        allow write: if isSuperAdmin();
      }

      // Administradores de colegio: solo el superadmin asigna/revoca.
      // Lectura: cada quien SU documento (loadAdminRole lo consulta para
      // saber su rol) y el superadmin la lista completa. Con isAdmin() un
      // sub-admin podia listar a los demas sub-admins y sus colegios.
      match /admins/{userId} {
        allow get: if request.auth != null
          && (request.auth.uid == userId || isSuperAdmin());
        allow list: if isSuperAdmin();
        allow write: if isSuperAdmin();
      }

      // Chats: cada usuario tiene SU copia del chat; el par (peer) puede
      // escribir en la copia del otro al enviar mensaje.
      // Antes el UPDATE miraba el peerId ENTRANTE: cualquiera podia pisar la
      // conversacion que otro tenia con un tercero (lastMsg, peerName,
      // peerPhotoURL) con solo poner su propio uid en peerId. Ahora, cuando
      // el que escribe NO es el dueno del buzon, se exige que el peerId YA
      // GUARDADO sea el suyo: solo puede tocar la copia del chat que es
      // suya-con-el-otro. El CREATE sigue abierto al par porque asi arranca
      // una conversacion nueva (startChatWithUser crea las dos copias a la
      // vez, con chatId determinista [uidA,uidB].sort()).
      match /users/{userId}/chats/{chatId} {
        function chatDelBuzon() {
          return get(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/chats/$(chatId)).data;
        }
        function esMiChatEnBuzonAjeno() {
          return exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/chats/$(chatId))
            && chatDelBuzon().get('peerId', '') == request.auth.uid;
        }
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && (request.auth.uid == userId || request.resource.data.peerId == request.auth.uid);
        allow update: if request.auth != null
          && (request.auth.uid == userId
              || (resource.data.get('peerId', '') == request.auth.uid
                  && request.resource.data.peerId == request.auth.uid));
        // Mensajes: se dejaba crear en el buzon de CUALQUIER usuario y en
        // cualquier chatId, sin relacion previa (spam directo a la bandeja
        // de un desconocido). Ahora, para escribir en buzon ajeno, el chat
        // tiene que existir alli y apuntarme a mi como peer — que es justo
        // lo que deja startChatWithUser antes de abrir la conversacion.
        // Suspendido = no escribe. Hasta el 2026-08-02 "suspender" no impedia
        // nada: seguia entrando, apareciendo en el directorio y mandando
        // mensajes. El corte del navegador se puede saltar desde la consola;
        // este no. Cuesta una lectura por mensaje enviado (volumen bajo: son
        // escrituras de persona, no de bucle), y solo se aplica al CREATE.
        function remitenteSuspendido() {
          return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/alumni/$(request.auth.uid))
            && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/alumni/$(request.auth.uid))
                 .data.get('accountStatus', 'activo') == 'suspendido';
        }
        match /messages/{messageId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null
            && request.resource.data.senderId == request.auth.uid
            && (request.auth.uid == userId || esMiChatEnBuzonAjeno())
            && !remitenteSuspendido();
        }
      }
    }
  }
}
